$HOME/.config/waybar/theme.css|${scrDir}/wbarconfgen.sh
/* LAGC Tech Dark — Waybar theme. Ships the LAGC color contract AND the LAGC
 * look (floating islands, borders, spacing). It is imported after defaults.css
 * so these overrides only apply while this theme is active; switching to an
 * upstream HyDE theme restores that theme's own Waybar look. Keeps user-style.css
 * empty for the end user, per HyDE's cascade. */

/* Color contract */
@define-color bar-bg rgba(6, 27, 43, 0.92);

@define-color main-bg #061B2B;
@define-color main-fg #EAF7FA;

@define-color wb-act-bg #1B5CFF;
@define-color wb-act-fg #FFFFFF;

@define-color wb-hvr-bg #17D7E8;
@define-color wb-hvr-fg #061B2B;

/* Transparent window; islands carry the surface. */
window#waybar {
    background-color: rgba(0, 0, 0, 0);
}

/* Theme-aware floating islands with quiet depth. */
window#waybar.top #pill {
    background-color: alpha(@main-bg, 0.99);
    border: 1px solid alpha(@main-fg, 0.20);
    border-radius: 12pt;
    box-shadow: 0 0 8px alpha(#000000, 0.14);
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 4px;
    margin-right: 4px;
}

window#waybar.top .modules-left,
window#waybar.top .modules-center,
window#waybar.top .modules-right {
    margin-left: 0;
    margin-right: 0;
    padding-left: 0;
    padding-right: 0;
}

window#waybar.top .modules-left #pill:first-child,
window#waybar.top .modules-left > widget:first-child > #pill,
window#waybar.top .modules-left > widget:first-child #pill {
    margin-left: 0;
}

window#waybar.top .modules-right #pill:last-child,
window#waybar.top .modules-right > widget:last-child > #pill,
window#waybar.top .modules-right > widget:last-child #pill {
    margin-right: 0;
}

window#waybar.top #pill,
window#waybar.top #pill * {
    min-height: 0;
}

/* Icon/text breathing room so glyphs do not stick to values at compact heights. */
window#waybar.top #pill label.module,
window#waybar.top #pill button,
window#waybar.top #pill box.module {
    margin-left: 0.38em;
    margin-right: 0.38em;
}

window#waybar.top #pill #custom-cpuinfo,
window#waybar.top #pill #custom-gpuinfo,
window#waybar.top #pill #cpu,
window#waybar.top #pill #memory,
window#waybar.top #pill #battery,
window#waybar.top #pill #backlight,
window#waybar.top #pill #network,
window#waybar.top #pill #pulseaudio,
window#waybar.top #pill #custom-updates {
    letter-spacing: 0.6px;
}

window#waybar.top #pill button {
    margin-top: 0;
    margin-bottom: 0;
    border-radius: 8pt;
    transition: all 150ms ease;
}

window#waybar.top #pill button:hover {
    background-color: alpha(@wb-hvr-bg, 0.16);
}

/* Active workspace: inset, flat, stable across hover/focus. */
window#waybar.top #pill #workspaces button.active,
window#waybar.top #pill #workspaces button.active:hover,
window#waybar.top #pill #workspaces button.active:focus {
    border: none;
    border-image: none;
    outline: none;
    background-color: @wb-act-bg;
    background-image: none;
    animation: none;
    min-height: 0;
    margin-top: 1px;
    margin-bottom: 1px;
    margin-left: 0.22em;
    margin-right: 0.22em;
    padding-left: 0.8em;
    padding-right: 0.8em;
    box-shadow: none;
}

#window {
    color: alpha(@main-fg, 0.88);
    padding-right: 0.35em;
}

/* State communicated with color only when it matters. */
#power-profiles-daemon.power-saver {
    color: @wb-hvr-bg;
}

#power-profiles-daemon.performance,
#battery.warning {
    color: @wb-act-bg;
}

#battery.critical:not(.charging) {
    color: #c94f6d;
}

#privacy-item.screenshare,
#privacy-item.audio-in {
    color: @wb-act-bg;
}

tooltip {
    background-color: alpha(@main-bg, 1.0);
    color: @main-fg;
    border: 1px solid alpha(@main-fg, 0.16);
    border-radius: 10pt;
    box-shadow: 0 4px 14px alpha(#000000, 0.18);
}
