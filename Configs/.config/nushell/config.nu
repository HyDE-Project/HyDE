# Your Nushell configuration.
#
# HyDE does not manage this file, so anything you put here survives an update.
#
# HyDE's own environment, aliases and prompt setup live in
# ~/.config/nushell/autoload/hyde.nu, which Nushell sources automatically
# before this file. To drop part of it, override the value here rather than
# editing the autoload file, which is replaced on update.

$env.config.show_banner = false
