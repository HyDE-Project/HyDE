${confDir}/kitty/theme.conf|${WALLBASH_SCRIPTS}/kitty.sh
foreground              #<wallbash_txt1>
background              #<wallbash_pry1>
selection_foreground    #<wallbash_pry1>
selection_background    #<wallbash_txt1>
cursor                  #<wallbash_pry4>
cursor_text_color       #<wallbash_txt4>

active_tab_foreground     #<wallbash_pry1>
active_tab_background     #<wallbash_pry3>
inactive_tab_foreground   #<wallbash_pry3>
inactive_tab_background   #<wallbash_pry1>

# black -- anchored near-black regardless of hue (#2185), not the accent curve:
# apps like nmtui/newt assume these slots contrast against color7/15
color0      #<wallbash_ansi_black>
color8      #<wallbash_ansi_black>

# red
color1      #<wallbash_4xa9>
color9      #<wallbash_4xa8>

# green
color2      #<wallbash_2xa9>
color10     #<wallbash_2xa8>

# yellow
color3      #<wallbash_3xa9>
color11     #<wallbash_3xa8>

# blue
color4      #<wallbash_1xa7>
color12     #<wallbash_1xa7>

# magenta
color5      #<wallbash_2xa7>
color13     #<wallbash_2xa7>

# cyan
color6      #<wallbash_3xa7>
color14     #<wallbash_3xa7>

# white -- anchored near-white regardless of hue (#2185), see color0/8 above
color7      #<wallbash_ansi_white>
color15     #<wallbash_ansi_white>
