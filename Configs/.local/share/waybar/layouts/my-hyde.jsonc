{
    // Polished, compact user layout preserved across HyDE updates.
    "layer": "top",
    "output": ["*"],
    "height": 22,
    "margin-top": 3,
    "margin-left": 4,
    "margin-right": 4,
    "exclusive": true,
    "reload_style_on_change": true,
    "include": [
        "$XDG_CONFIG_HOME/waybar/modules/*json*",
        "$XDG_CONFIG_HOME/waybar/includes/includes.json"
    ],

    "modules-left": [
        "group/pill#sensors",
        "group/pill#clock"
    ],
    "group/pill#sensors": {
        "orientation": "inherit",
        "modules": ["cpu", "memory", "custom/cpuinfo", "custom/gpuinfo"]
    },
    "group/pill#clock": {
        "orientation": "inherit",
        "modules": ["idle_inhibitor", "clock"]
    },

    "modules-center": ["group/pill#navigation"],
    "group/pill#navigation": {
        "orientation": "inherit",
        "modules": ["hyprland/workspaces", "hyprland/window"]
    },
    "hyprland/window": {
        "format": "   {0}",
        "rotate": 0,
        "separate-outputs": true,
        "max-length": 34,
        "rewrite": {
            "(.*)@archlinux:(.*)": "$1   ",
            "(.*) — Mozilla Firefox": "$1 󰈹  ",
            "(.*)Mozilla Firefox": "Firefox 󰈹  ",
            "(.*) - Visual Studio Code": "$1 󰨞  ",
            "(.*)Visual Studio Code": "Code 󰨞  ",
            "(.*) - Code - OSS": "$1 󰨞  ",
            "(.*)Code - OSS": "Code 󰨞  ",
            "(.*) — Nautilus": "$1 󰉋  ",
            "(.*)Spotify": "Spotify 󰓇  ",
            "(.*)Steam": "Steam 󰓓  ",
            "(.*) - Discord": "$1   ",
            "(.*)Netflix": "Netflix 󰝆  ",
            "(.*) — Google chrome": "$1   ",
            "(.*)Google chrome": "Google chrome   ",
            "(.*) — Github": "$1   ",
            "(.*)Github": "Github   "
        }
    },

    "group/volumecontrol": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 180,
            "children-class": "volumecontrol-drawer",
            "transition-left-to-right": false,
            "click-to-reveal": false
        },
        "modules": ["pulseaudio#output", "pulseaudio#input"]
    },
    "pulseaudio#output": {
        "format": "<span font_family='JetBrainsMono Nerd Font'>{icon}</span>  {volume}%",
        "format-muted": "<span font_family='JetBrainsMono Nerd Font'>󰖁</span>  {volume}%",
        "rotate": 0,
        "on-click": "pavucontrol-qt -t 3 || pavucontrol -t 3",
        "on-click-right": "hyde-shell volumecontrol -s ''",
        "on-click-middle": "hyde-shell volumecontrol -o m",
        "on-scroll-up": "hyde-shell volumecontrol -o i",
        "on-scroll-down": "hyde-shell volumecontrol -o d",
        "tooltip-format": "{icon} {desc} // {volume}%",
        "scroll-step": 5,
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰋋",
            "headset": "󰋋",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["󰕿", "󰖀", "󰕾"]
        }
    },
    "pulseaudio#input": {
        "format": "<span font_family='JetBrainsMono Nerd Font'>{format_source}</span>  {source_volume}%",
        "format-source": "󰍬",
        "format-source-muted": "󰍭",
        "rotate": 0,
        "on-click": "pavucontrol-qt -t 4 || pavucontrol -t 4",
        "on-click-middle": "hyde-shell volumecontrol -i m",
        "on-scroll-up": "hyde-shell volumecontrol -i i",
        "on-scroll-down": "hyde-shell volumecontrol -i d",
        "tooltip-format": "{format_source} {source_desc} // {source_volume}%",
        "scroll-step": 5
    },

    "modules-right": [
        "group/pill#controls",
        "group/pill#status",
        "group/pill#actions"
    ],
    "group/pill#controls": {
        "orientation": "inherit",
        "modules": [
            "custom/brightness-panel",
            "network",
            "group/volumecontrol",
            "custom/updates",
            "custom/keybindhint"
        ]
    },
    "group/pill#status": {
        "orientation": "inherit",
        "modules": [
            "privacy",
            "group/hide-tray",
            "power-profiles-daemon",
            "battery"
        ]
    },
    "group/customize": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 180,
            "children-class": "customize-drawer",
            "transition-left-to-right": false,
            "click-to-reveal": false
        },
        "modules": ["custom/theme", "custom/wallchange", "custom/wbar"]
    },
    "group/pill#actions": {
        "orientation": "inherit",
        "modules": [
            "group/customize",
            "custom/cliphist",
            "custom/hyde-menu",
            "custom/power"
        ]
    },

    // User-owned icon spacing. Full copies of the shared HyDE module
    // definitions from ~/.local/share/waybar/modules/ (cpu, memory,
    // battery) taken on 2026-09-15. Only change: double space between
    // icon and text so glyphs do not stick at 22 px. Re-sync the bodies
    // if upstream changes intervals, states or tooltips.
    "cpu": {
        "interval": 10,
        "format": "󰍛  {usage}%",
        "rotate": 0,
        "format-alt": "{icon0}{icon1}{icon2}{icon3}",
        "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
      },
    "memory": {
        "states": {
          "critical": 90,
          "high": 60,
          "medium": 30,
          "low": 0
        },
        "interval": 30,
        "format": "{icon}  {used:0.1f}G",
        "format-alt": "{icon}  {percentage}%",
        "format-icons": {
          "critical": "\uf421",
          "high": "\udb81\udcc5",
          "medium": "\udb83\udf85",
          "low": "\udb83\udf86"
        },
        "rotate": 0,
        "max-length": 10,
        "tooltip": true,
        //"tooltip-format": "\udb83\udf86 {percentage}%\n\ue266 {used:0.1f}GB/{total:0.1f}GB",
        "tooltip-format": "\udb83\udf86 Memory usage: {percentage}%\n\ue266 Used: {used:0.2f} GiB / {total:0.2f} GiB\n\udb80\udf5b Available: {avail:0.2f} GiB\n\uf233 Swap used: {swapUsed:0.2f} GiB / {swapTotal:0.2f} GiB ({swapPercentage}%)"
      },
    "battery": {
        "states": {
          // "good": 95,
          // "warning": 30,
          // "critical": 20
        },
        "format": "{icon}  {capacity}%",
        "rotate": 0,
        "format-charging": "  {capacity}%",
        "format-plugged": "  {capacity}%",
        "format-alt": "{time}  {icon}",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
      }
}
