{
  "custom/caffeine": {
    "return-type": "json",
    // Trailing space: the Nerd Font coffee-cup glyphs render ~3px wider than
    // their logical advance (measured with Pango at the bar's 10px font
    // size), bleeding into whatever module a layout places right after this
    // one (#2206) -- e.g. clock in hyprdots/11.jsonc. custom/hyprsunset's
    // format already ends in a space for the same kind of overflow.
    "format": "{} ",
    "rotate": 0,
    "justify": "center",
    "exec": "hyde-shell caffeine -rq",
    "on-click": "hyde-shell caffeine -t -P waybar,21",
    "interval": "once",
    "signal": 21,
    "tooltip": true
  }
}
