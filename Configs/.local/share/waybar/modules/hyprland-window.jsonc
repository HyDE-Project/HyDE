{
    "hyprland/window": {
        "format": "\uf303 {title}",
        "rotate": 0,
        "separate-outputs": true,
        "rewrite": {
            "(.*)@archlinux:(.*)": "$1 \uf489 ",
            "(.*) \u2014 Mozilla Firefox": "$1 \udb80\ude39 ",
            "(.*)Mozilla Firefox": "$1Firefox \udb80\ude39 ",    
            "(.*) - Visual Studio Code": "$1 \ue8da ",
            "(.*)Visual Studio Code": "$1Code \ue8da ",
            "(.*) - Code - OSS": "$1 \ue8da ",
            "(.*)Code - OSS": "$1Code \ue8da ",
            "(.*) - VSCodium": "$1 \ue951 ",
            "(.*)VSCodium": "$1Codium \ue951 ",
            "(.*) \u2014 Dolphin": "$1 \udb80\ude4b ",
            "(.*)Spotify": "$1Spotify \udb81\udcc7 ",
            "(.*)Steam": "$1Steam \udb81\udcd3 ",
            "(.*) - Discord": "$1 \uf1ff ",
            "(.*)Netflix": "$1Netflix \udb81\udf46 ",
            "(.*) \u2014 Google chrome": "$1 \ue743 ",
            "(.*)Google chrome": "$1Google chrome \ue743 ",
            "(.*)New Tab - Chromium": "$1Chromium \ue743 ",
            // [ ] forces waybar to sort and evaluate this AFTER "New Tab" rule
            "(.*)[ ]- Chromium": "$1 \ue743 ", 
            "(.*) \u2014 Github": "$1 \ue709 ",
            "(.*)Github": "$1Github \ue709 ",
            "(.*)Spotify Free": "$1Spotify \udb81\udcc7 ",
            "(.*)Spotify Premium": "$1Spotify \udb81\udcc7 "
        },
        "max-length": 50
    }
}
