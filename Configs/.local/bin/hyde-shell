#!/usr/bin/env bash
# This script will soon be used to resolve $PATHS and LIB_DIR specific to hyde
# wallbash script can source this script to resolve the paths cleanly on a separate shell
# shellcheck disable=SC1091
# shellcheck disable=SC2086
# shellcheck disable=SC1090


python_initialized() {

	local python_script="${LIB_DIR}/hyde/pyutils/python_env.py"
	local venv="${XDG_STATE_HOME:-$HOME/.local/state}/hyde/python_env"

	if [[ -x "${venv}/bin/python" ]]; then
		# shellcheck disable=SC1091
		source "${venv}/bin/activate"
		"${venv}/bin/python" "${python_script}" sync >/dev/null 2>&1 && return 0
		_tn "hyde_shell.sync_failed" "Sync failed; rebuilding Python environment..."
		"${venv}/bin/python" "${python_script}" rebuild
		return $?
	fi

	_tn "hyde_shell.python_env_missing_create" "Python environment not found; creating..."
	python3 "${python_script}" create >/dev/null 2>&1 && return 0
	_tn "hyde_shell.create_failed" "Create failed; attempting rebuild..."
	python3 "${python_script}" rebuild

}

python_activate() {

	local python_env="${XDG_STATE_HOME:-$HOME/.local/state}/hyde/python_env/bin/activate"
	if [[ -r "${python_env}" ]]; then
		# shellcheck disable=SC1090
		source "${python_env}"
	else
		_tn "hyde_shell.python_env_missing" "Warning: Python virtual environment not found at %s" "${python_env}"
		_tn "hyde_shell.python_env_setup_hint" "You may need to run 'hyde-shell pyinit' to set it up."
		python_initialized
	fi

}

lua_initialized() {
python_activate
python3 "${LIB_DIR}/hyde/pyutils/lua_env.py" sync || \
python3 "${LIB_DIR}/hyde/pyutils/lua_env.py" rebuild
}


initialized() {
	cat <<EOF
HYDE_SHELL_INIT=1
BIN_DIR="${BIN_DIR}"
LIB_DIR="${LIB_DIR}"
SHARE_DIR="${SHARE_DIR}"
PATH=${PATH}
HYDE_SCRIPTS_PATH=${HYDE_SCRIPTS_PATH}
export BIN_DIR LIB_DIR SHARE_DIR PATH HYDE_SCRIPTS_PATH HYDE_SHELL_INIT
EOF
	#? Use sed to remove any shebang hints to avoid conflicts with "eval"
	command cat "${LIB_DIR}/hyde/globalcontrol.sh"
}

USAGE() {
	local cols
	cols=$(tput cols 2>/dev/null || echo 80)
	local sep
	sep=$(printf '─%.0s' $(seq 1 "$((cols - 2))"))

	local _R=$'\e[0m' _BOLD=$'\e[1m' _DIM=$'\e[2m' _CYAN=$'\e[36m'

	printf '\n%s  HyDE Shell%s\n' "$_BOLD" "$_R"
	printf '  %s%s%s\n\n' "$_DIM" "$sep" "$_R"

	printf '  %s%s%s\n' "$_BOLD" "$(_t "hyde_shell.usage_title" "USAGE")" "$_R"
	printf '    %s\n\n' "$(_t "hyde_shell.usage_command" "hyde-shell %s[command]%s %s[args]%s" "$_CYAN" "$_R" "$_DIM" "$_R")"

	printf '  %s%s%s\n' "$_BOLD" "$(_t "hyde_shell.commands_title" "COMMANDS")" "$_R"
	local cmds=(
		'help, -h' "$(_t "hyde_shell.command.help" "Show this help message")"
		'-r, reload' "$(_t "hyde_shell.command.reload" "Reload HyDE")"
		'-s, scripts' "$(_t "hyde_shell.command.scripts" "List available scripts (formatted)")"
		'wallbash <script>' "$(_t "hyde_shell.command.wallbash" "Execute a wallbash script")"
		'version, -v' "$(_t "hyde_shell.command.version" "Show version information")"
		'release-notes' "$(_t "hyde_shell.command.release_notes" "Show release notes")"
		'completions [shell]' "$(_t "hyde_shell.command.completions" "Generate completions (bash|zsh|fish)")"
		'validate [args]' "$(_t "hyde_shell.command.validate" "Validate HyDE configuration")"
		'pyinit' "$(_t "hyde_shell.command.pyinit" "Initialize Python virtual environment")"
		'uv <cmd> [pkg]' "$(_t "hyde_shell.command.uv" "Manage packages (install|uninstall|list)")"
		'init' "$(_t "hyde_shell.command.init" "Source initialization script")"
		'logout' "$(_t "hyde_shell.command.logout" "Log out of the current session")"
		'lock-session' "$(_t "hyde_shell.command.lock_session" "Lock the current session")"
	)
	for ((i = 0; i < ${#cmds[@]}; i += 2)); do
		printf '    %s%-26s%s %s\n' "$_CYAN" "${cmds[i]}" "$_R" "${cmds[i + 1]}"
	done
	printf '\n'

	printf '  %s%s%s\n' "$_BOLD" "$(_t "hyde_shell.scripts_title" "SCRIPTS")" "$_R"
	printf '    %s\n' "$(_t "hyde_shell.scripts_run" "Run any script by name (without extension):")"
	printf '      %shyde-shell theme.switch%s\n' "$_DIM" "$_R"
	printf '      %shyde-shell wallpaper%s\n\n' "$_DIM" "$_R"
	printf '    %s\n\n' "$(_t "hyde_shell.scripts_hint" "Use %shyde-shell -s%s to list all available scripts." "$_CYAN" "$_R")"

	printf '  %s%s%s\n\n' "$_DIM" "$sep" "$_R"
}

call_wallbashScript() {
	local scriptName=$1
	shift
	local args=("${@}")
	local dirs=("${WALLBASH_DIRS[@]}")
	sanitized_dirs=()
	for dir in "${dirs[@]}"; do
		if [[ -d "$dir" ]]; then
			sanitized_dirs+=("$dir")
		fi
	done
	dirs=("${sanitized_dirs[@]}")
	script_path=$(find -L "${dirs[@]}" -type f -path "*/scripts/*" -name "${scriptName}.sh" -exec echo {} \; -quit)

	for func in $(compgen -A function); do
		export -f "${func?}"
	done

	if [[ -n "$script_path" ]]; then
		"$script_path" "${args[@]}"
	else
		_tn "hyde_shell.wallbash_usage" "Usage: wallbash [script-name] [args]"
		_tn "hyde_shell.wallbash_description" "Executes the specified wallbash script with the provided arguments."
		_tn "hyde_shell.wallbash_available" "Available scripts:"
		for dir in "${dirs[@]}"; do
			if [[ -d "$dir" ]]; then
				echo -e "\n[ $dir ]"
				find -L "$dir" -type f -path "*/scripts/*" -name "*.sh" -exec basename {} \;
			fi
		done
	fi

}

hyde_reload() {

	print_log -sec "hyde" "$(_t "hyde_shell.reloading" "Reloading HyDE")"
	python_initialized
	"$LIB_DIR/hyde/wallpaper/cache.sh" commence -t ""
	"$LIB_DIR/hyde/theme.switch.sh"
}

list_script_path() {
	IFS=':' read -ra RAW_DIRS <<<"$HYDE_SCRIPTS_PATH"
	declare -A _seen_dirs
	for dir in "${RAW_DIRS[@]}"; do
		[[ -z "$dir" ]] && continue
		[[ -n "${_seen_dirs[$dir]}" ]] && continue
		_seen_dirs["$dir"]=1
		[[ -d "$dir" ]] && find -L "$dir" -maxdepth 1 -type f \( -name "*.sh" -o -name "*.py" \) -exec echo {} \;
	done
}

list_script() {
	# Plain newline-delimited script filenames (with extension) for completion consumers.
	list_script_path | xargs -I{} basename {} | sort -u
}

get_version() {
	# shellcheck source=/dev/null
	if [[ ! -f "${XDG_STATE_HOME:-$HOME/.local/state}/hyde/version" ]]; then
		_tn "hyde_shell.version_file_missing" "HyDE version file not found. Please update HyDE."
		exit 1
	fi
	# shellcheck source=/dev/null
	source "${XDG_STATE_HOME:-$HOME/.local/state}/hyde/version"
	# Extract only the date part from HYDE_VERSION using Bash parameter expansion
	# HYDE_VERSION_DATE="${HYDE_VERSION%%-*}"
	local hydectl_version hyprland_version hyprctl_version hyde_ipc_version hyprctl_output
	hydectl_version="$(hydectl version 2>/dev/null || _t "hyde_shell.tool_missing" "%s not found" "hydectl")"
	hyprland_version="$(hyprland -v 2>/dev/null | head -n1 || _t "hyde_shell.tool_missing" "%s not found" "hyprland")"
	if hyprctl_output=$(hyprctl version 2>/dev/null | head -n1); then
		hyprctl_version="$(_t "hyde_shell.hyprctl_running" "%s (Running Instance)" "$hyprctl_output")"
	else
		hyprctl_version="$(_t "hyde_shell.hyprctl_missing" "hyprctl not found or not running")"
	fi
	hyde_ipc_version="$(hyde-ipc --version 2>/dev/null || _t "hyde_shell.tool_missing" "%s not found" "hyde-ipc")"

	_tn "hyde_shell.version_heading" "HyDE, your Development Environment"
	printf '\n'
	_tn "hyde_shell.version_label" "Version: %s" "$HYDE_VERSION"
	_tn "hyde_shell.branch_label" "Branch: %s" "$HYDE_BRANCH"
	_tn "hyde_shell.commit_hash_label" "Commit Hash: %s" "$HYDE_COMMIT_HASH"
	_tn "hyde_shell.remote_label" "Remote: %s" "$HYDE_REMOTE"
	_tn "hyde_shell.restore_date_label" "Restore Date: %s" "$HYDE_VERSION_LAST_CHECKED"
	_tn "hyde_shell.last_commit_message_label" "Last Commit Message: %s" "$HYDE_VERSION_COMMIT_MSG"
	printf '\n'
	_tn "hyde_shell.tools_title" "Tools:"
	printf 'hydectl: %s\n' "$hydectl_version"
	printf '%s\n' "$hyprland_version"
	printf '%s\n' "$hyprctl_version"
	printf '%s\n' "$hyde_ipc_version"
	printf '\n\n'
	_tn "hyde_shell.update_notice" "HyDE updates every friday, so please check for updates regularly."
	_tn "hyde_shell.release_notes_hint" "Run 'hyde-shell release-notes' to see the latest changes."
	_tn "hyde_shell.contribution_notice" "HyDE is a community-driven project, and contributions are welcome."
	printf '\n'

}

get_release_notes() {
	# shellcheck source=/dev/null
	if [[ ! -f "${XDG_STATE_HOME:-$HOME/.local/state}/hyde/version" ]]; then
		_tn "hyde_shell.version_file_missing" "HyDE version file not found. Please update HyDE."
		exit 1
	fi
	#shellcheck source=/dev/null
	source "${XDG_STATE_HOME:-$HOME/.local/state}/hyde/version"
	_tn "hyde_shell.release_notes_title" "HyDE Release Notes:"
	printf '%s\n' "$HYDE_RELEASE_NOTES"
}

get_completion_data() {
	# Get all available commands and scripts
	local built_in_commands=("--help" "help" "-h" "-r" "reload" "-s" "scripts" "wallbash" "--version" "version" "-v" "--release-notes" "release-notes" "--list-script" "--list-script-path" "--completions" "completions" "uv")
	export HYDE_BUILT_IN_COMMANDS="${built_in_commands[*]}"
}

gen_bash_completion() {
	get_completion_data

	cat <<'BASH_COMPLETION'
# Bash completion for hyde-shell
_hyde_shell_completion() {
    local cur prev words cword
    _init_completion 2>/dev/null || {
        COMPREPLY=()
        cur="${COMP_WORDS[COMP_CWORD]}"
        prev="${COMP_WORDS[COMP_CWORD-1]}"
    }

    local built_in_commands hyde_scripts wallbash_scripts
    built_in_commands="--help help -h -r reload -s scripts wallbash --version version -v --release-notes release-notes --list-script --list-script-path --completions uv"

    # Get dynamic completions from hyde-shell
    if command -v hyde-shell >/dev/null 2>&1; then
        hyde_scripts=$(hyde-shell --list-script 2>/dev/null | sed 's/\.[^.]*$//' | tr '\n' ' ')

        # Get wallbash scripts - just --help for now
        wallbash_scripts="--help"
    fi

    # Only provide completions for the first argument
    if [[ $COMP_CWORD -eq 1 ]]; then
        # First argument: complete with all available commands
        local all_commands="$built_in_commands $hyde_scripts"
        COMPREPLY=($(compgen -W "$all_commands" -- "$cur"))
    elif [[ $COMP_CWORD -eq 2 ]]; then
        # Second argument: only for specific commands that take arguments
        case $prev in
            wallbash)
                COMPREPLY=($(compgen -W "$wallbash_scripts" -- "$cur"))
                return 0
                ;;
            --completions)
                COMPREPLY=($(compgen -W "bash zsh fish" -- "$cur"))
                return 0
                ;;
            *)
                # No completion for other commands
                COMPREPLY=()
                return 0
                ;;
        esac
    else
        # No completion for 3rd argument and beyond
        COMPREPLY=()
        return 0
    fi
}

complete -F _hyde_shell_completion hyde-shell
BASH_COMPLETION
}

gen_zsh_completion() {
	get_completion_data

	cat <<'ZSH_COMPLETION'
#compdef hyde-shell

_hyde_shell() {
    local cur prev words
    cur="${words[CURRENT]}"
    prev="${words[CURRENT-1]}"

    local built_in_commands hyde_scripts wallbash_scripts
    built_in_commands=("--help" "help" "-h" "-r" "reload" "-s" "scripts" "wallbash" "--version" "version" "-v" "--release-notes" "release-notes" "--list-script" "--list-script-path" "--completions" "uv")

    # Get dynamic completions
    if (( $+commands[hyde-shell] )); then
        local scripts_raw
        scripts_raw=(${(f)"$(hyde-shell --list-script 2>/dev/null)"})
        hyde_scripts=(${scripts_raw[@]%.*})  # Remove extensions

        # Get wallbash scripts - just --help for now
        wallbash_scripts=("--help")
    fi

    # Only complete for first two arguments max
    if [[ $CURRENT -eq 2 ]]; then
        # First argument: all commands
        local all_commands=($built_in_commands $hyde_scripts)
        compadd -a all_commands
    elif [[ $CURRENT -eq 3 ]]; then
        # Second argument: only for specific commands
        case $words[2] in
            wallbash)
                compadd -a wallbash_scripts
                return 0
                ;;
            --completions)
                compadd "bash" "zsh" "fish"
                return 0
                ;;
            *)
                # No completion for other commands
                return 0
                ;;
        esac
    else
        # No completion for 3rd argument and beyond
        return 0
    fi
}

compdef _hyde_shell hyde-shell
ZSH_COMPLETION
}

fish_completion_escape() {
	local text="$1"
	text="${text//\\/\\\\}"
	text="${text//\"/\\\"}"
	printf '%s' "$text"
}

gen_fish_completion() {
	get_completion_data

	cat <<'FISH_COMPLETION'
# Fish completion for hyde-shell

function __hyde_shell_get_commands
    echo "--help
help
-h
-r
reload
-s
scripts
wallbash
--version
version
-v
--release-notes
release-notes
--list-script
--list-script-path
--completions"

    # Get hyde scripts
    if command -v hyde-shell >/dev/null 2>&1
        hyde-shell --list-script 2>/dev/null | sed 's/\.[^.]*$//'
    end
end

function __hyde_shell_get_wallbash_scripts
    # Just --help for now
    echo "--help"
end

# Main completions
complete -c hyde-shell -f
FISH_COMPLETION

	local desc_commands desc_wallbash desc_completion_types
	local desc_help desc_reload desc_scripts desc_version desc_release_notes desc_completions
	desc_commands="$(fish_completion_escape "$(_t "hyde_shell.commands_title" "Hyde shell commands")")"
	desc_wallbash="$(fish_completion_escape "$(_t "hyde_shell.command.wallbash" "Wallbash scripts")")"
	desc_completion_types="$(fish_completion_escape "$(_t "hyde_shell.command.completions" "Shell completion types")")"
	desc_help="$(fish_completion_escape "$(_t "hyde_shell.command.help" "Display help message")")"
	desc_reload="$(fish_completion_escape "$(_t "hyde_shell.command.reload" "Reload HyDE")")"
	desc_scripts="$(fish_completion_escape "$(_t "hyde_shell.command.scripts" "List available scripts")")"
	desc_version="$(fish_completion_escape "$(_t "hyde_shell.command.version" "Show version information")")"
	desc_release_notes="$(fish_completion_escape "$(_t "hyde_shell.command.release_notes" "Show release notes")")"
	desc_completions="$(fish_completion_escape "$(_t "hyde_shell.command.completions" "Generate shell completions")")"

	printf '# First argument completions\n'
	printf 'complete -c hyde-shell -n "not __fish_seen_subcommand_from (__hyde_shell_get_commands)" -a "(__hyde_shell_get_commands)" -d "%s"\n\n' "$desc_commands"
	printf '# Wallbash subcommand completions\n'
	printf 'complete -c hyde-shell -n "__fish_seen_subcommand_from wallbash" -a "(__hyde_shell_get_wallbash_scripts)" -d "%s"\n\n' "$desc_wallbash"
	printf '# Completions subcommand\n'
	printf 'complete -c hyde-shell -n "__fish_seen_subcommand_from --completions" -a "bash zsh fish" -d "%s"\n\n' "$desc_completion_types"
	printf '# Option descriptions\n'
	printf 'complete -c hyde-shell -s h -l help -d "%s"\n' "$desc_help"
	printf 'complete -c hyde-shell -s r -d "%s"\n' "$desc_reload"
	printf 'complete -c hyde-shell -s s -l scripts -d "%s"\n' "$desc_scripts"
	printf 'complete -c hyde-shell -s v -l version -d "%s"\n' "$desc_version"
	printf 'complete -c hyde-shell -l release-notes -d "%s"\n' "$desc_release_notes"
	printf 'complete -c hyde-shell -l list-script -d "%s"\n' "$desc_scripts"
	printf 'complete -c hyde-shell -l list-script-path -d "%s"\n' "$desc_scripts"
	printf 'complete -c hyde-shell -l completions -d "%s"\n' "$desc_completions"
}

generate_completions() {
	local shell_type="$1"

	case "$shell_type" in
	bash)
		gen_bash_completion
		;;
	zsh)
		gen_zsh_completion
		;;
	fish)
		gen_fish_completion
		;;
	*)
		_tn "hyde_shell.completions_usage" "Usage: hyde-shell --completions [bash|zsh|fish]"
		_tn "hyde_shell.completions_description" "Generate shell completions for the specified shell"
		return 1
		;;
	esac
}

hyde-logout() {
	if uwsm check is-active; then
		uwsm stop
	elif [[ -n "${HYPRLAND_INSTANCE_SIGNATURE}" ]]; then
		if command -v hyprshutdown >/dev/null 2>&1; then
			hyprshutdown --top-label "Stay HyDErated!🫧"
		else
			hyprctl dispatch exit 0
		fi
	fi
}

run_command() {
	# Convert to array, deduplicate, and filter out empty entries
	IFS=':' read -ra RAW_DIRS <<<"$HYDE_SCRIPTS_PATH"
	declare -A seen_dirs
	SCRIPT_DIRS=()
	for dir in "${RAW_DIRS[@]}"; do
		# Skip empty entries (handles multiple colons like :::)
		[[ -z "$dir" ]] && continue
		# Deduplicate directories
		[[ -n "${seen_dirs[$dir]}" ]] && continue
		seen_dirs["$dir"]=1
		# Only add existing directories
		[[ -d "$dir" ]] && SCRIPT_DIRS+=("$dir")
	done

	# Try to find and execute the command in priority order
	for dir in "${SCRIPT_DIRS[@]}"; do
		# Try .sh extension first
		if [[ -f "$dir/${1}.sh" ]]; then
			exec bash "$dir/${1}.sh" "${@:2}"
		# Try .lua extension second
		elif [[ -f "$dir/${1}.lua" 	]]; then
			lua_runtime="${XDG_STATE_HOME:-$HOME/.local/state}/hyde/lua_env/bin/lua"
			activate_script="${XDG_STATE_HOME:-$HOME/.local/state}/hyde/lua_env/bin/activate_posix"
			if [[ -f "$activate_script" ]] && [[ -x "$lua_runtime" ]]; then
				source "$activate_script"
			else
				# I hate automating this as building the environment is slow and should be optional for now.
				# Calling for lua gods to speed up the process 🙏
				print_log -warn "$(_t "hyde_shell.lua_env_missing" "Lua environment not found!")" " $(_t "hyde_shell.lua_env_setup_hint" "Please run 'hyde-shell luainit' to set up the environment.")"
				send_notifs "$(_t "hyde_shell.lua_env_missing" "Lua environment not found!")" "$(_t "hyde_shell.lua_env_setup_hint" "Please run 'hyde-shell luainit' to set up the environment.")"
				exit 1
			fi
			exec "${XDG_STATE_HOME:-$HOME/.local/state}/hyde/lua_env/bin/lua" "$dir/${1}.lua" "${@:2}"
		# Try .py extension third
		elif [[ -f "$dir/${1}.py" ]]; then
			exec "${XDG_STATE_HOME:-$HOME/.local/state}/hyde/python_env/bin/python" "$dir/${1}.py" "${@:2}"
		# Try exact name (executable)
		elif [[ -f "$dir/${1}" && -x "$dir/${1}" ]]; then
			exec "$dir/${1}" "${@:2}"
		fi
	done

	# Finally try as a direct file path
	if [[ -f "$1" && -x "$1" ]]; then
		exec "$1" "${@:2}"
	else
		_tn "hyde_shell.command_not_found" "Command not found: %s" "$1"
		_tn "hyde_shell.available_commands" "Available commands:"
		list_scripts_pretty
	fi
}

run_uv() {
	local project_dir="${LIB_DIR}/hyde"
	local venv_path="${XDG_STATE_HOME:-$HOME/.local/state}/hyde/python_env"
	shift
	local subcmd="${1:-help}"
	shift 2>/dev/null || true
	case "$subcmd" in
	install)
		UV_PROJECT_ENVIRONMENT="$venv_path" uv add "$@" --project "$project_dir"
		;;
	uninstall | remove)
		UV_PROJECT_ENVIRONMENT="$venv_path" uv remove "$@" --project "$project_dir"
		;;
	list)
		UV_PROJECT_ENVIRONMENT="$venv_path" uv pip list --python "${venv_path}/bin/python"
		;;
	*)
		_tn "hyde_shell.uv_usage" "Usage: hyde-shell uv [install|uninstall|list] [packages...]"
		_tn "hyde_shell.uv_install_help" "  install   <pkg>  → runs: uv add"
		_tn "hyde_shell.uv_uninstall_help" "  uninstall <pkg>  → runs: uv remove"
		_tn "hyde_shell.uv_list_help" "  list             → list installed packages"
		;;
	esac
}

# Run luarocks inside the LuaJIT environment
run_luarocks() {
	shift
	local luarocks_bin="${XDG_STATE_HOME:-$HOME/.local/state}/hyde/lua_env/bin/luarocks"
	if [[ -x "$luarocks_bin" ]]; then
		source ${XDG_STATE_HOME:-$HOME/.local/state}/hyde/lua_env/bin/activate_posix
		"$luarocks_bin" "$@"
	else
		_tn "hyde_shell.luarocks_missing" "luarocks not found in LuaJIT environment."
		_tn "hyde_shell.luarocks_setup_hint" "You may need to run 'python %s/hyde/lua_env.py rebuild' to set up the environment." "${LIB_DIR}"
	fi
}

run_pypr() {

	python_activate
	shift

	if command -v pypr >/dev/null 2>&1; then

		socket_path="${XDG_RUNTIME_DIR}/hypr/${HYPRLAND_INSTANCE_SIGNATURE}/.pyprland.sock"
		if [[ ! -f "${XDG_CONFIG_HOME:-$HOME/.config}/pypr/config.toml" ]]; then
			send_notifs "$(_t "hyde_shell.pypr_config_missing_title" "Missing config.toml")" "$(_t "hyde_shell.pypr_config_missing_body" "Please create a config.toml file in %s to configure PyPR." "${XDG_CONFIG_HOME:-$HOME/.config}/pypr/")"
			exit 1
		fi

		if [[ -S "$socket_path" ]] && pgrep -u "$USER" pypr >/dev/null 2>&1; then
			local -a msg=("$@")
			((${#msg[@]} == 0)) && msg=("help")
			if ! printf '%s\n' "${msg[*]}" | nc -N -U "$socket_path" 2>/dev/null; then #! openbsd netcat only
				if ! printf '%s\n' "${msg[*]}" | socat - UNIX-CONNECT:"$socket_path" 2>/dev/null; then
					if ! printf '%s\n' "${msg[*]}" | ncat -U "$socket_path" 2>/dev/null; then
						if ! pypr "${msg[@]}"; then
							print_log -sec "pypr" "$(_t "hyde_shell.pypr_socket_error" "Error communicating with socket: %s" "$socket_path")"
							exit 1
						fi
					fi
				fi
			fi

		else
			print_log -sec "pypr" "$(_t "hyde_shell.pypr_starting_fresh" "PyPR is not running properly, starting fresh")"
			[[ -S "$socket_path" ]] && print_log -y "$(_t "hyde_shell.pypr_removing_stale_socket" "Removing stale socket: %s" "$socket_path")"
			pgrep -u "$USER" pypr >/dev/null && print_log -y "$(_t "hyde_shell.pypr_killing_existing" "Killing existing pypr process")"
			rm -f "$socket_path"

			exec app2unit.sh -t service pypr
		fi

	else
		UV_PROJECT_ENVIRONMENT="${XDG_STATE_HOME:-$HOME/.local/state}/hyde/python_env" uv add "pyprland==3.3.1" --project "${LIB_DIR}/hyde"
	fi
}

list_scripts_pretty() {
	local cols
	cols=$(tput cols 2>/dev/null || echo 80)
	local sep
	sep=$(printf '─%.0s' $(seq 1 "$((cols - 2))"))

	local _R=$'\e[0m' _BOLD=$'\e[1m' _DIM=$'\e[2m'
	local _VIOLET=$'\e[35m' _GREEN=$'\e[92m'

	IFS=':' read -ra RAW_DIRS <<<"$HYDE_SCRIPTS_PATH"
	declare -A seen_dirs
	local SCRIPT_DIRS=()

	for dir in "${RAW_DIRS[@]}"; do
		[[ -z "$dir" ]] && continue
		[[ -n "${seen_dirs[$dir]}" ]] && continue
		seen_dirs["$dir"]=1
		[[ -d "$dir" ]] && SCRIPT_DIRS+=("$dir")
	done

	local total=0

	printf '\n%s  %s%s\n' "$_BOLD" "$(_t "hyde_shell.available_scripts_title" "Available Scripts")" "$_R"
	printf '  %s%s%s\n' "$_DIM" "$sep" "$_R"

	for dir in "${SCRIPT_DIRS[@]}"; do
		local scripts=()
		while IFS= read -r f; do
			[[ -n "$f" ]] && scripts+=("$f")
		done < <(find -L "$dir" -maxdepth 1 -type f \( -name "*.sh" -o -name "*.py" \) -exec basename {} \; 2>/dev/null | sort)

		[[ ${#scripts[@]} -eq 0 ]] && continue

		printf '\n  %s%s%s\n' "$_VIOLET" "$dir" "$_R"

		unset groups roots
		declare -A groups roots

		# --- detectar raíces ---
		for s in "${scripts[@]}"; do
			local name="${s%.*}"
			if [[ "$name" == *.* ]]; then
				local root="${name%%.*}"
				roots["$root"]=1
			fi
		done

		# --- agrupar correctamente ---
		for s in "${scripts[@]}"; do
			local name="${s%.*}"

			if [[ "$name" == *.* ]]; then
				local root="${name%%.*}"
				groups["$root"]+="$name "
			else
				if [[ -n "${roots[$name]}" ]]; then
					# es raíz de un grupo
					groups["$name"]="$name ${groups[$name]}"
				else
					# standalone
					groups["$name"]="$name"
				fi
			fi
		done

		# --- imprimir ---
		for key in $(printf "%s\n" "${!groups[@]}" | sort); do
			read -ra items <<<"${groups[$key]}"

			if [[ ${#items[@]} -gt 1 ]]; then
				printf "    %s%s%s\n" "$_GREEN" "$key" "$_R"

				for item in "${items[@]}"; do
					if [[ "$item" != "$key" ]]; then
						printf "      %s%s%s\n" "$_DIM" "$item" "$_R"
					fi
					((total++))
				done
			else
				printf "    %s%s%s\n" "$_GREEN" "$key" "$_R"
				((total++))
			fi
		done
	done

	local dir_word
	dir_word="$(_t "hyde_shell.directory_plural" "directories")"
	((${#SCRIPT_DIRS[@]} == 1)) && dir_word="$(_t "hyde_shell.directory_singular" "directory")"

	printf '\n  %s%s%s\n' "$_DIM" "$sep" "$_R"
	printf '  %s%s%s\n\n' "$_DIM" "$(_t "hyde_shell.scripts_summary" "%d scripts across %d %s" "$total" "${#SCRIPT_DIRS[@]}" "$dir_word")" "$_R"
}

lock_session() {
	#? hyde-shell lock-session wraps around the lockscreen.sh script
	#? lockscreen.sh activates the set lockscreen blindly
	#? however, lock-session will check if the lockscreen is set FD's ScreenSaver
	#? if it is, it will use loginctl lock-session
	#? otherwise, it will use lockscreen.sh
	if busctl --user list | grep -q "org.freedesktop.ScreenSaver"; then
		_tn "hyde_shell.lock_using_screensaver" "Using org.freedesktop.ScreenSaver for locking"
		loginctl lock-session
	else
		lockscreen.sh
	fi

}

#*--------------------------------------------------------------------------------

if [[ -z "${BASH_SOURCE[0]}" ]]; then
	EXECUTABLE="${0}"
else
	EXECUTABLE="${BASH_SOURCE[0]}"
fi

BIN_DIR=$(dirname "$(which "${EXECUTABLE:-hyde-shell}")")
LIB_DIR=$(realpath "${BIN_DIR}/../lib")
SHARE_DIR=$(realpath "${BIN_DIR}/../share")
PATH="${XDG_CONFIG_HOME:-$HOME/.config}/hyde/scripts:$BIN_DIR:$LIB_DIR/hyde:$PATH" #! I added this to the PATH to make sure that the hyde commands are available in the shell
# Define hyde scripts search paths (colon-separated, user configurable)
HYDE_SCRIPTS_PATH="${HYDE_SCRIPTS_PATH:-${XDG_CONFIG_HOME:-$HOME/.config}/hyde/scripts:${LIB_DIR}/hyde}:${XDG_DATA_HOME:-$HOME/.local/share}/waybar/scripts:${XDG_CONFIG_HOME:-$HOME/.config}/waybar/scripts"

export BIN_DIR LIB_DIR SHARE_DIR PATH HYDE_SCRIPTS_PATH

#*--------------------------------------------------------------------------------

if ! declare -F _t >/dev/null; then
	# shellcheck source=/dev/null
	if [[ -r "${LIB_DIR}/hyde/i18n.sh" ]]; then
		source "${LIB_DIR}/hyde/i18n.sh"
	else
		_t() {
			local key="${1:-}"
			local default="${2:-$key}"
			if (( $# >= 2 )); then
				shift 2
			else
				shift "$#"
			fi
			if (( $# > 0 )); then
				printf "$default" "$@"
			else
				printf '%s' "$default"
			fi
		}
		_tn() {
			_t "$@"
			printf '\n'
		}
	fi
fi

#*--------------------------------------------------------------------------------

# Prepare runtime directory for hyde
[[ -d "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hyde" ]] || mkdir -p "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hyde"

# Priority commands
case "$1" in
app)
	export PATH="${HYDE_SCRIPTS_PATH}:${PATH}"
	[[ "${HYDEPY}" -eq 1 ]] && python_activate
	shift
	exec app2unit.sh "$@"
	;;
init | --init)
	initialized
	exit 0
	;;
lock-session)
	lock_session
	exit 0
	;;
*)
	export HYDE_SHELL_INIT=1
	;;
esac

# shellcheck disable=SC1091
if ! source "${LIB_DIR}/hyde/globalcontrol.sh"; then
	_tn "hyde_shell.load_error" "Error: Could not load HyDE, broken installation?"
	exit 1
fi

#*--------------------------------------------------------------------------------

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then

	case $1 in
	logout)
		hyde-logout
		;;

	pypr)
		run_pypr "${@}"
		exit 0
		;;

	uv)
		run_uv "${@}"
		exit 0
		;;
	luarocks)
		run_luarocks "${@}"
		exit 0
		;;
	-r | reload)
		hyde_reload
		;;

	wallbash)
		shift
		call_wallbashScript "$@"
		;;
	--release-notes | release-notes)
		get_release_notes
		;;
	--version | version | -v)
		get_version
		;;
	--help | help | -h)
		USAGE
		;;
	-s | scripts)
		list_scripts_pretty
		;;
	--list-script)
		list_script
		;;
	--list-script-path)
		list_script_path
		;;
	--completions | completions)
		shift
		generate_completions "$1"
		;;
	validate)
		shift
		if command -v hyde-config >/dev/null 2>&1; then
			hyde-config -no-daemon "${@}"
		else
			_tn "hyde_shell.hyde_config_missing" "hyde-config not found. Please make sure it is in \$PATH."
		fi
		exit 0
		;;
	pyinit)
		python_initialized
		;;
	luainit)
		lua_initialized
		;;
	"")
		for func in $(compgen -A function); do
			export -f "${func?}"
		done
		;;
	*)
		run_command "$@"
		;;
	esac

fi
