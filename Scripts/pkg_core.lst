# --------------------------------------------------- // System
uwsm                                                   # A standalone Wayland session manager
pipewire                                               # audio/video server
pipewire-alsa                                          # pipewire alsa client
pipewire-audio                                         # pipewire audio client
pipewire-jack                                          # pipewire jack client
pipewire-pulse                                         # pipewire pulseaudio client
gst-plugin-pipewire                                    # pipewire gstreamer client
wireplumber                                            # pipewire session manager
pavucontrol                                            # pulseaudio volume control
pamixer                                                # pulseaudio cli mixer
networkmanager                                         # network manager
network-manager-applet                                 # network manager system tray utility
bluez                                                  # bluetooth protocol stack
bluez-utils                                            # bluetooth utility cli
blueman                                                # bluetooth manager gui
brightnessctl                                          # screen brightness control
playerctl                                              # media controls
udiskie                                                # manage removable media

# --------------------------------------------------- // Display Manager
greetd                                                 # display manager (agreety TUI ships with it)
greetd-regreet                                         # graphical GTK greeter
cage                                                   # Wayland kiosk compositor to run the greeter

# --------------------------------------------------- // Window Manager
hyprland                                               # wlroots-based wayland compositor
dunst                                                  # notification daemon
rofi                                                   # application launcher
waybar                                                 # system bar
awww                                                   # wallpaper
hyprlock                                               # lock screen
grim                                                   # screenshot tool
hyprpicker                                             # color picker
slurp                                                  # region select for screenshot/screenshare
satty                                                  # Modern Screenshot Annotation
cliphist                                               # clipboard manager
wl-clip-persist                                        # Keep Wayland clipboard even after programs close (avoids crashes)
hyprsunset                                             # blue light filter

# --------------------------------------------------- // Dependencies
lua                                                    # lua interpreter, required by the hyprland configuration
polkit-gnome                                           # GNOME authentication agent
xdg-desktop-portal-hyprland                            # xdg desktop portal for hyprland
xdg-desktop-portal-gtk                                 # file picker and dbus  integration
xdg-user-dirs                                          # Manage user directories like ~/Desktop and ~/Music
pacman-contrib                                         # for system update check
parallel                                               # for parallel processing
jq                                                     # for json processing
imagemagick                                            # for image processing
ffmpegthumbnailer                                      # thumbnailer for nautilus previews
libnotify                                              # for notifications
noto-fonts-emoji                                       # emoji font

# --------------------------------------------------- // Theming
nwg-look                                               # gtk configuration tool

# --------------------------------------------------- // Applications
firefox                                                # browser
kitty                                                  # terminal
nautilus                                               # file manager (GTK)
gvfs                                                   # virtual filesystem for nautilus
gvfs-mtp                                               # MTP support for nautilus
sushi                                                  # nautilus previewer
loupe                                                  # image viewer (GTK)
gnome-text-editor                                      # text editor (GTK)
gnome-calculator                                       # calculator (GTK)
gnome-system-monitor                                   # system monitor (GTK)
gnome-control-center                                   # settings (GTK)
file-roller                                            # archive manager (GTK)
gnome-autoar                                           # auto-extract archives for nautilus
unzip                                                  # extracting zip files
nwg-displays                                           # monitor management utility
fzf                                                    # Command-line fuzzy finder

# --------------------------------------------------- // Shell
starship|zsh                                           # customizable shell prompt written in Rust
# starship-git                                         # The cross-shell prompt for astronauts
starship|fish                                          # customizable shell prompt

fastfetch                                              # system information fetch tool

# --------------------------------------------------- // HyDE
hyprquery                                              # A CLI utility for querying configuration values from hypr-related configuration. Using native hyprlang lib.
hypridle                                               # idle daemon
luarocks                                               # lua package manager
