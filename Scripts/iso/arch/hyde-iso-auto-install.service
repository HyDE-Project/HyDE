[Unit]
Description=Unattended HyDE Arch Linux installation
Wants=network-online.target
After=network-online.target
ConditionPathExists=/root/hyde-iso-config.json
Conflicts=getty@tty1.service

[Service]
Type=oneshot
TimeoutStartSec=10min
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
ExecStart=/usr/local/bin/hyde-iso-auto-install

[Install]
WantedBy=multi-user.target
